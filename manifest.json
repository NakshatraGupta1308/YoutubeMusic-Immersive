{
  "manifest_version": 3,
  "name": "YT Music Immersive",
  "version": "1.0.0",
  "description": "Fullscreen 3D audio visualizer, album-art ambience and synced lyrics for YouTube Music.",
  "permissions": ["storage"],
  "host_permissions": ["https://lrclib.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["dist/content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
